NEXT_PUBLIC_SUPABASE_URL= 
NEXT_PUBLIC_SUPABASE_ANON_KEY= 

# Service role key from Supabase project settings > API. Server-only, never
# expose this with a NEXT_PUBLIC_ prefix - it bypasses RLS entirely. Only
# used by src/lib/supabase/admin.ts for the admin "reset member password"
# tool at /admin/members.
SUPABASE_SERVICE_ROLE_KEY=

# Shared passcode required to self-signup at /join. Server-only - never
# expose this with a NEXT_PUBLIC_ prefix.
TRIP_JOIN_PASSCODE=

# Local-only bootstrap for the primary admin (npm run ensure-admin).
# Do NOT put real passwords in git — only in .env.local / Vercel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Public site URL used in login-detail emails/texts (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://winter-reunion.vercel.app

# Optional: email new members their login after /join (Resend).
# https://resend.com — create an API key, then either:
# - test with: Winter Reunion <onboarding@resend.dev> (to your Resend account email only)
# - or verify a domain and use: Winter Reunion <hello@yourdomain.com>
RESEND_API_KEY=
# From-address must be a Resend-verified sender (use onboarding@resend.dev for tests).
RESEND_FROM_EMAIL=Winter Reunion <onboarding@resend.dev>
# Optional: where replies go (can be your Gmail).
RESEND_REPLY_TO=

# Optional: text new members their login after /join (Twilio).
# https://console.twilio.com — Account SID, Auth Token, and a Twilio number
# in E.164 format (e.g. +15551234567). Trial accounts can only text numbers
# you verify in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

