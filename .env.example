NEXT_PUBLIC_SUPABASE_URL= 
NEXT_PUBLIC_SUPABASE_ANON_KEY= 

# Service role key from Supabase project settings > API. Server-only, never
# expose this with a NEXT_PUBLIC_ prefix - it bypasses RLS entirely. Only
# used by src/lib/supabase/admin.ts for the admin "reset member password"
# tool at /admin/members.
SUPABASE_SERVICE_ROLE_KEY=

# Shared passcode required to self-signup at /join. Server-only - never
# expose this with a NEXT_PUBLIC_ prefix.
TRIP_JOIN_PASSCODE=
